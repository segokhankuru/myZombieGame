  melee:
  - id: melee.dagger
    displayName: HANCER
    text: Baslangic bicagi. Hizli ve affedici; mermi biriktirmenin yolu.
    damageMultiplier: 1
    swingTimeMultiplier: 1
    rangeMultiplier: 1
